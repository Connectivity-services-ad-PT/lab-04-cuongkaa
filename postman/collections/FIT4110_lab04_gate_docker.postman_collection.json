    {
      "name": "02_Auth_Negative_Boundary",
      "item": [
        {
          "name": "GET decisions without token returns 401 Problem",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/decisions",
              "host": ["{{baseUrl}}"],
              "path": ["decisions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.environment.get('env') === 'mock') {",
                  "  pm.test('Mock response is documented', function () { pm.expect([200, 401]).to.include(pm.response.code); });",
                  "} else {",
                  "  pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
                  "  const json = pm.response.json();",
                  "  pm.test('Problem schema is valid', function () { pm.expect(json.type).to.be.a('string'); pm.expect(json.title).to.be.a('string'); pm.expect(json.status).to.eql(401); pm.expect(json.errors).to.be.an('array'); });",
                  "}"
                ]
              }
            }
          ]
